# Copy this file to .env and fill in your values.
# .env is gitignored at the project root, so it stays local to your machine.

# Free tier key from https://gnews.io — enables live destination news.
# Without this, the news tab falls back to generic sample travel tips.
GNEWS_API_KEY=

# Key from https://countrystatecity.in — sign up, then find it on your
# account dashboard. Enables global city/state/country search-as-you-type.
# Without this, search falls back to a small sample city list.
CSC_API_KEY=

# Key from https://aistudio.google.com/apikey — enables natural-language
# place search (e.g. "quiet beach towns in Kerala") via Gemini.
# Without this, that search mode returns no results with a disclaimer.
GEMINI_API_KEY=
# Optional: override the Gemini model (default: gemini-3.6-flash).
GEMINI_MODEL=

# Free key from https://unsplash.com/developers (create an app, copy the
# Access Key). Primary source for destination photos on the search page.
UNSPLASH_ACCESS_KEY=

# Free key from https://www.pexels.com/api/ — used when Unsplash is not
# configured or returns no photos. Without either key, the gallery is hidden.
PEXELS_API_KEY=

# Free key from https://console.cloud.google.com — create a project, enable
# "YouTube Data API v3", then create an API key. Shows destination travel
# videos. Free quota is ~100 searches/day; results are cached 24h per
# destination. Without this, the videos section is hidden.
YOUTUBE_API_KEY=

# Public Instagram videos via Hashtag Search (e.g. #chandigarh). Free, but
# gated by Meta — you need ALL of:
#   1. An Instagram Business or Creator account linked to a Facebook Page
#   2. A Meta app (https://developers.facebook.com/apps) with the
#      `instagram_basic` permission and the "Instagram Public Content Access"
#      feature approved through App Review (typically 2–4 weeks)
#   3. A long-lived access token for that account (user tokens expire after
#      ~60 days; a System User token from Business Manager does not)
# Limit: 30 unique hashtags per rolling 7 days. Without these, the Instagram
# section is hidden.
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=
# Optional Graph API version, e.g. v23.0 (defaults to your app's version).
IG_GRAPH_VERSION=

# Prices are shown in INR, converted from the USD cost baselines at a live
# rate (frankfurter.app, no key needed). This rate is used only if the live
# rate can't be fetched. Defaults to 95 if unset.
USD_TO_INR_RATE=

PORT=4000

# Comma-separated list of browser origins allowed to call this API (CORS).
# Defaults to the Angular dev server if unset.
ALLOWED_ORIGINS=http://localhost:4200

# Secret used to sign login session tokens (JWT). Set this to a long random
# string, e.g. `openssl rand -hex 32`. If unset, a random secret is
# generated per process start, which invalidates all sessions on restart —
# fine for local dev, not for anything you want to keep working across
# restarts/deploys.
JWT_SECRET=
