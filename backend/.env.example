# Copy this file to .env and fill in your values.
# .env is gitignored at the project root, so it stays local to your machine.

# Free tier key from https://gnews.io — enables live destination news.
# Without this, the news tab falls back to generic sample travel tips.
GNEWS_API_KEY=

# Key from https://countrystatecity.in — sign up, then find it on your
# account dashboard. Enables global city/state/country search-as-you-type.
# Without this, search falls back to a small sample city list.
CSC_API_KEY=

# Key from https://aistudio.google.com/apikey — enables natural-language
# place search (e.g. "quiet beach towns in Kerala") via Gemini.
# Without this, that search mode returns no results with a disclaimer.
GEMINI_API_KEY=
# Optional: override the Gemini model (default: gemini-3.6-flash).
GEMINI_MODEL=

PORT=4000

# Comma-separated list of browser origins allowed to call this API (CORS).
# Defaults to the Angular dev server if unset.
ALLOWED_ORIGINS=http://localhost:4200

# Secret used to sign login session tokens (JWT). Set this to a long random
# string, e.g. `openssl rand -hex 32`. If unset, a random secret is
# generated per process start, which invalidates all sessions on restart —
# fine for local dev, not for anything you want to keep working across
# restarts/deploys.
JWT_SECRET=
